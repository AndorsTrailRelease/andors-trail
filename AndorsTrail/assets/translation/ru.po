#: worldmap.xml:world1:crossroads
msgid "Crossroads Guardhouse"
msgstr "Пост на Перекрёстке"

#: worldmap.xml:world1:flagstone
msgid "Flagstone Prison"
msgstr "Тюрьма Флагстоуна"

