#: conversationlist_omi2.json:ehrenfest_7b:1
#: conversationlist_omi2.json:moyra_12:1
#: conversationlist_omi2.json:prim_tavern_guest4_17c:1
#: conversationlist_omi2.json:capvjern_22:0
