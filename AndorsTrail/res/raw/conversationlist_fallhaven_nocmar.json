    {
        "id":"nocmar_complete_3",
        "message":"But no, I cannot work it here. Too many eyes, too many whispers. If I were caught forging heartsteel in this shop, it would mean ruin for me. I need a place that is safe, hidden, yet...proper. Somewhere I can work without Lord Geomyr's men breathing down my neck. A place where I am allowed to be.",
        "switchToNPC":"nocmar",
        "replies":[
            {
                "text":"N",
                "nextPhraseID":"nocmar_complete_4"
            }
