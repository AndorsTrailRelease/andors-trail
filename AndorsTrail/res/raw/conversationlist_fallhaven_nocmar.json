    {
        "id":"nocmar_complete_2",
        "message":"He studies it with reverence, then grows troubled.",
        "switchToNPC":"none",
        "replies":[
            {
                "text":"Oh, no!",
                "nextPhraseID":"nocmar_complete_3"
