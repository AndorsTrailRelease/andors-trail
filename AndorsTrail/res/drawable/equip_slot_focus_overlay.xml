<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <!-- First draw a border -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="2dp" />
                    <stroke
                        android:width="4dp"
                        android:color="@color/ui_blue_palette_highlight_gray_mid" />
                        <!-- This should reference a theme-based color android:color="?attr/ui_theme_focus_border_color",
                         but very old android (4.4, API 19) doesn't support attr references for themeable colors in
                         drawables, so we use a generic "@color/ui_blue_palette_highlight_gray_mid" instead.
                         It's not worth using a special version-dependant resource just for this, but
                         TODO: If/when minSdk is bumped to 21 or later (Android 5.0) this can be restored -->
                </shape>
            </item>
            <!-- Then draw a semi-transparent overlay to brighten the background, including border  -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#80FFFFFF" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
